{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "typecheck": "vue-tsc --noEmit",
        "dev": "vite",
        "format": "prettier --write \"resources/js/**/*.{ts,vue}\" vite.config.ts tsconfig.json",
        "format:check": "prettier --check \"resources/js/**/*.{ts,vue}\" vite.config.ts tsconfig.json"
    },
    "devDependencies": {
        "@types/node": "^26.5.1",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1.0",
        "prettier": "^3.9.4",
        "typescript": "^6.0.2",
        "vite": "^8.1.1",
        "vue-tsc": "^3.3.11"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.5.0",
        "@vitejs/plugin-vue": "^6.0.7",
        "nergous-ui-vue": "1.0.4",
        "vue": "^3.5.39"
    }
}
