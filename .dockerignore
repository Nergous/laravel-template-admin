# --- VCS / IDE / agent metadata ---

.git
.gitignore
.gitattributes
.github
.idea
.vscode
.claude

# Local Composer executable and installer (the image copies composer from composer:2).
composer.phar
composer-setup.php

# --- dependencies/artifacts (installed/built inside the image) ---

node_modules
.tmp
vendor
public/build
public/hot
public/storage

# --- runtime storage (created by the entrypoint / mounted as a volume) ---

storage/app/public/*
!storage/app/public/.gitkeep
storage/app/private/*
!storage/app/private/.gitkeep
# Local database dumps (app:db-backup) — real data, never part of the image.
storage/app/backups
storage/framework/cache/*
!storage/framework/cache/.gitkeep
storage/framework/sessions/*
!storage/framework/sessions/.gitkeep
storage/framework/views/*
!storage/framework/views/.gitkeep
# Fake disks left by the test suite (Storage::fake).
storage/framework/testing
storage/logs/*
!storage/logs/.gitkeep
bootstrap/cache/*
!bootstrap/cache/.gitkeep

# --- tests / linters (not needed in the prod image) ---

tests
phpunit.xml
.phpunit.result.cache
.editorconfig

# --- secrets / local env (not put into the image; .env is mounted/provided from outside) ---

.env
.env.*
!.env.example

# --- compose / docker meta-files (not part of the application code) ---

docker-compose.yml
docker-compose.override.yml
compose.dev.yaml
compose.*.yaml
.dockerignore

# --- DB files / documentation / design sources ---

*.sqlite
*.md
!README.md
figma
docs
design-system

# Any database dump or transfer archive at any depth (real user data).
**/*.sql
**/*.sql.gz
**/*.sql.enc
**/*.sqlite.enc
transfer

# --- local instructions and audit reports (not needed in the prod image) ---

CLAUDE.md
AGENTS.md
audit
