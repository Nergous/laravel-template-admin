# =============================================================================
#  FrankenPHP / Caddy config for the Laravel Admin Template.
#
#  SERVER_NAME is set via the environment (default ":8000" from the Dockerfile).
#  Behind a reverse proxy (nginx/traefik) terminating TLS — we keep HTTP on :8000,
#  trustProxies is already configured in bootstrap/app.php.
#
#  Worker mode (optional, higher throughput): uncomment the `worker` line
#  and set FRANKENPHP_CONFIG="worker ./public/index.php" — but it keeps
#  state between requests and requires worker-compatible code. For the template it is
#  off by default (classic mode, safe for any Laravel application).
# =============================================================================

{
	# Disable the Caddy admin API — not needed in the container.
	admin off

	# The log level is controlled from outside; only the format here.
	frankenphp {
		# worker ./public/index.php
	}

	# Behind an external TLS proxy, Caddy's automatic HTTPS is not needed.
	auto_https off
}

{$SERVER_NAME:":8000"} {
	root * /app/public
	encode zstd br gzip

	# Browser caching of the Vite output: every file name under /build/assets
	# carries a content hash, so a new build produces new names and a year-long
	# cache is safe. Only successful responses are cached, so a missing file
	# never sticks in a browser.
	@hashed path /build/assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable" {
		match status 2xx
	}

	# Uploaded media (/storage → symlink to storage/app/public) is served STRICTLY
	# as static: this handle never reaches php_server, so no file under
	# /storage is executed as PHP (defense-in-depth for S1 — even if a .php ends up
	# on disk). nosniff stops the browser from guessing the type (txt→html).
	#
	# Images, PDF, audio and video open inline (a PDF link from the media library
	# opens in the browser; browsers refuse to show a PDF under a sandbox CSP).
	# These types cannot run scripts with nosniff. Every other file (documents,
	# archives, and anything that could be HTML/SVG) is forced to download
	# (Content-Disposition: attachment) under a sandbox CSP with default-src
	# 'none' — stored XSS through an uploaded file stays blocked (S8).
	@storage path /storage/*
	@storageDownload {
		path /storage/*
		not path_regexp (?i)\.(jpe?g|png|gif|webp|avif|pdf|mp4|webm|mov|mp3|wav|ogg|m4a)$
	}
	header @storageDownload Content-Disposition attachment
	header @storageDownload Content-Security-Policy "default-src 'none'; sandbox"
	handle @storage {
		header X-Content-Type-Options nosniff
		file_server
	}

	# The rest of the traffic: Laravel health check (/up), assets from public/build and the SPA —
	# through PHP. Bare php_server: its built-in fallback already does
	# "existing file, else index.php". Do NOT add a custom
	# `try_files ... /index.php?{query}` — on some FrankenPHP builds the file
	# matcher checks the literal name including `?{query}`, the rewrite never
	# fires and every non-file URL becomes a bare Caddy 404.
	handle {
		php_server
	}

	log {
		output stderr
		format console
	}
}
