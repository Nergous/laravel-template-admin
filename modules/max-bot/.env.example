# Used by pytest (loaded via python-dotenv in conftest.py)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bot-test-db
DB_USERNAME=root
DB_PASSWORD=

API_TOKEN=fake_test_token
API_BASE_URL=https://platform-api2.max.ru
BOT_ID=261592040

LOG_LEVEL_BOT=DEBUG

# Update delivery mode: "polling" (default, long-polling) or "webhook".
# BOT_MODE=polling
#
# Webhook mode (only read when BOT_MODE=webhook):
#   WEBHOOK_URL    — public HTTPS endpoint MAX pushes updates to (required, https only)
#   WEBHOOK_HOST   — local bind host for the aiohttp receiver (default 0.0.0.0)
#   WEBHOOK_PORT   — local bind port (default 8080; also EXPOSEd in the Dockerfile)
#   WEBHOOK_PATH   — URL path of the receiver route (default /webhook)
#   WEBHOOK_SECRET — 5-256 chars; verified via the X-Max-Bot-Api-Secret header
# WEBHOOK_URL=https://your-domain.example/webhook
# WEBHOOK_HOST=0.0.0.0
# WEBHOOK_PORT=8080
# WEBHOOK_PATH=/webhook
# WEBHOOK_SECRET=change-me-secret

# Root of the Laravel public disk (storage/app/public) where media library files
# live. The bot reads files attached to messages from here and uploads them to MAX.
# In Docker this is set to /app/storage/app/public and the storage volume is mounted
# read-only (see docker-compose.yml). For a local run leave it empty — it defaults
# to the repo's storage/app/public.
# MEDIA_ROOT=
