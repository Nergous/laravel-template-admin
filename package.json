{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "typecheck": "vue-tsc --noEmit",
        "test:js": "node --test \"tests/js/*.test.ts\"",
        "test:e2e": "playwright test",
        "dev": "vite",
        "format": "prettier --write \"resources/js/**/*.{ts,vue}\" \"tests/e2e/*.ts\" vite.config.ts playwright.config.ts tsconfig.json",
        "format:check": "prettier --check \"resources/js/**/*.{ts,vue}\" \"tests/e2e/*.ts\" vite.config.ts playwright.config.ts tsconfig.json"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@playwright/test": "^1.63.0",
        "@types/node": "^26.6.4",
        "concurrently": "^10.0.5",
        "laravel-vite-plugin": "^3.2.0",
        "prettier": "^3.9.9",
        "typescript": "^6.0.2",
        "vite": "^8.3.2",
        "vue-tsc": "^3.3.12"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.8.0",
        "@vitejs/plugin-vue": "^6.0.9",
        "nergous-ui-vue": "1.1.0",
        "vue": "^3.5.43"
    }
}
